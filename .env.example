# Application
APP_ENV=dev
LOG_LEVEL=INFO
APP_SMOKE_MODE=true
NOTIFY_ADMINS_ON_STARTUP=false

# HTTP / Telegram webhook
WEB_SERVER_HOST=0.0.0.0
PORT=8080
WEBHOOK_BASE_URL=https://accents-dev.example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace-with-a-long-random-secret

# Telegram. DEV and production MUST use different bot tokens.
BOT_TOKEN=
ADMIN_IDS=123456789

# PostgreSQL. Prefer DATABASE_URL in Coolify.
DATABASE_URL=postgresql://accents:replace-me@postgres:5432/accents

# Legacy DB_* fallback remains supported during migration only.
# DB_HOST=postgres
# DB_PORT=5432
# POSTGRES_DB=accents
# POSTGRES_USER=accents
# POSTGRES_PASSWORD=replace-me

# Redis FSM storage. Prefer REDIS_URL in Coolify.
USE_REDIS=true
REDIS_URL=redis://:replace-me@redis:6379/0

# Legacy Redis fallback remains supported during migration only.
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=replace-me
